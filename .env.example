# ============================================================================
# AI Document Processing Pipeline - example environment file
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ============================================================================

# --- App ---
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
# Must be a long random string in any non-dev environment.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Database (file-based SQLite; created automatically) ---
DATABASE_URL=sqlite:///./app.db

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_SECONDS=300

# --- Administrator bootstrap ---
# The ONLY address that may hold the admin role. `POST /auth/register` always
# creates a normal user - even for this address. Create the admin with:
#   scripts\seed_admin.py     (prompts for the password; nothing is stored in clear)
ADMIN_EMAIL=

# --- Uploads / storage ---
# Stored OUTSIDE the web root. Never served as static files.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50
MAX_TEXT_CHARS=100000
EXTRACTION_TIMEOUT_SECONDS=20
MAX_DOCS_PER_USER=1000
MAX_STORAGE_MB_PER_USER=200

# --- AI provider (zero-cost by default) ---
# mock | openai_compatible
AI_PROVIDER=mock
AI_MAX_INPUT_CHARS=20000
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=2000
# Optional real provider (DISABLED by default). Works with any OpenAI-compatible
# endpoint, including local models (Ollama, LM Studio, vLLM...).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# --- Business validation ---
BUSINESS_TOTAL_TOLERANCE=0.01

# --- CORS (explicit allowlist, never "*" with credentials) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limits (format: "<count>/<second|minute|hour>") ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_REPROCESS=10/minute
RATE_LIMIT_EXPORT=5/minute
RATE_LIMIT_API=60/minute

# --- Export ---
EXPORT_MAX_ROWS=5000

# --- API docs exposure (turn off in production) ---
EXPOSE_DOCS=true
